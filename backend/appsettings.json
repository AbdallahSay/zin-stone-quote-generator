{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=<YOUR_SUPABASE_HOST>;Port=5432;Database=postgres;Username=postgres;Password=<YOUR_SUPABASE_PASSWORD>;SSL Mode=Require;"
  },
  "Supabase": {
    "Url": "<YOUR_SUPABASE_PROJECT_URL>",
    "ServiceKey": "<YOUR_SUPABASE_SERVICE_ROLE_KEY>",
    "Bucket": "quotes-private"
  },
  "WhatsApp": {
    "Enabled": false,
    "PhoneNumberId": "<CONFIGURED_IN_FUTURE_SETUP>",
    "AccessToken": "<CONFIGURED_IN_FUTURE_SETUP>"
  },
  "Smtp": {
    "Host": "<YOUR_SMTP_HOST>",
    "Port": 587,
    "Username": "<YOUR_SMTP_USERNAME>",
    "Password": "<YOUR_SMTP_PASSWORD>",
    "FromEmail": "info@zinstone.example",
    "FromName": "ZIN STONE"
  },
  "PdfShift": {
    "ApiKey": "<YOUR_PDFSHIFT_API_KEY_OPTIONAL>"
  },
  "Security": {
    "SigningKey": "<YOUR_HMAC_SIGNING_SECRET>",
    "DefaultQuotePassword": "<CONFIGURED_IN_PROD_ENV>",
    "DefaultAdminPassword": "<CONFIGURED_IN_PROD_ENV>",
    "DefaultOwnerPassword": "<CONFIGURED_IN_PROD_ENV>"
  },
  "Telegram": {
    "BotToken": "<CONFIGURED_IN_PROD_ENV>",
    "ChatIds": ""
  }
}
