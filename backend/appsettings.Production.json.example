{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=db.<YOUR-PROJECT-REF>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<YOUR_PASSWORD>;SSL Mode=Require;"
  },
  "Supabase": {
    "Url": "https://<YOUR-PROJECT-REF>.supabase.co",
    "ServiceKey": "<YOUR_SUPABASE_SERVICE_ROLE_KEY>",
    "Bucket": "quotes-private"
  },
  "WhatsApp": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://zin-stone-quote-generator.netlify.app",
      "https://zin-stone-api.onrender.com"
    ]
  },
  "Telegram": {
    "BotToken": "<YOUR_TELEGRAM_BOT_TOKEN>",
    "ChatIds": ""
  }
}
